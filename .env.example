# GEMINI_API_KEY: Required for Google Gemini Clinical Intelligence & Multimodal OCR
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE POSTGRESQL & ROW LEVEL SECURITY CONFIGURATION
# ==============================================================================
# Optional: If not provided, Healthora automatically uses its local encrypted database
# (.data/healthora_db.json) with identical user isolation and schema enforcement.

# Remote Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=""

# Safe Public Anon / Publishable Key for Client-Side Operations with RLS
# (Can also be set as VITE_SUPABASE_ANON_KEY for direct client bundling)
SUPABASE_ANON_KEY=""

# Client-Side Vite Environment Variables (Optional mirror for client-side direct access)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# PRIVILEGED SERVICE ROLE KEY (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used exclusively on the Express backend for administrative tasks and RLS validation.
# NEVER prefix with VITE_ or expose in client-side code.
SUPABASE_SERVICE_ROLE_KEY=""
